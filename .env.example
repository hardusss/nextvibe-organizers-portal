# Copy to .env.local and fill in. All three are public (NEXT_PUBLIC_*) and end up in the browser bundle.

# NextVibe API. Optional: defaults to production (https://api.nextvibe.io/api/v1)
NEXT_PUBLIC_API_URL=

# Google OAuth client ID for "Sign in with Google"
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Solana RPC endpoint used by the wallet adapter (sign-in with wallet, raffle payouts)
NEXT_PUBLIC_SOLANA_RPC_URL=
